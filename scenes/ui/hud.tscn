[node name="RestartConfirm" type="ConfirmationDialog" parent="."]
title = "Restart game?"
initial_position = 1
dialog_text = "This wipes ALL progress (roster, inventory, essence, gauntlet) and jumps back to a brand-new game, intro dialogue included. Only meant for testing — there's no undo."
ok_button_text = "Restart"

